{
  "name": "regent-app",
  "version": "100.7.1",
  "packageManager": "bun@1.3.14",
  "forkedFrom": {
    "repo": "decolua/9router",
    "version": "0.5.104",
    "commit": "87a74e1b"
  },
  "private": true,
  "description": "9Router web dashboard",
  "scripts": {
    "release": "node scripts/release.mjs",
    "backport": "node scripts/backport.mjs",
    "dev": "next dev --port 20127",
    "dev:webpack": "next dev --webpack --port 20127",
    "build": "next build --webpack",
    "postbuild": "node scripts/copy-standalone-assets.mjs",
    "postbuild:bun": "node scripts/copy-standalone-assets.mjs",
    "start": "node custom-server.js --port 20127",
    "dev:bun": "bun --bun next dev --webpack --port 20127",
    "build:bun": "bun --bun next build --webpack",
    "start:bun": "bun ./.next/standalone/custom-server.js",
    "cli:pack": "npm --prefix cli run pack:cli",
    "cli:publish": "npm --prefix cli run publish:cli",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/ui-smoke.mjs",
    "lint:design": "node scripts/ci/design-lint.mjs",
    "test": "vp test run",
    "coverage": "vp test run --coverage",
    "lint": "vp lint",
    "check": "vp check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@next/third-parties": "^16.2.9",
    "@node-saml/node-saml": "^5.1.0",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "chalk": "^5.6.2",
    "confbox": "^0.2.4",
    "enquirer": "^2.4.1",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "jose": "^6.1.3",
    "marked": "^18.0.1",
    "material-symbols": "^0.44.6",
    "monaco-editor": "^0.55.1",
    "next": "^16.1.6",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "nodemailer": "10.0.15",
    "open": "^11.0.0",
    "ora": "^9.1.0",
    "prop-types": "^15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-is": "^16.13.1",
    "recharts": "^3.7.0",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^8.0.5",
    "sql.js": "^1.14.1",
    "tailwind-merge": "^3.7.0",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "axe-core": "4.10.3",
    "happy-dom": "20.0.0",
    "playwright-core": "1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "optionalDependencies": {
    "@aws-sdk/credential-providers": "^3.1135.0",
    "better-sqlite3": "^12.6.2",
    "wreq-js": "^3.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "comment_aws_sdk_credential_providers": "kept in optionalDependencies (npm still installs these by default) and imported lazily in shared/awsCredentials.js — only AWS Bedrock connections using profile/SSO mode need it; static accessKeyId/secretAccessKey connections never load it",
  "comment_better_sqlite3": "kept in optionalDependencies so npm install doesn't fail on systems without build tools — sql.js is used as fallback at runtime",
  "comment_wreq_js": "kept in optionalDependencies: native per-platform bindings; only loaded for connections with a TLS fingerprint set in the dashboard, and proxyFetch falls back to native fetch if it can't load",
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "trustedDependencies": [
    "better-sqlite3"
  ],
  "comment_trusted_dependencies": "bun runs install scripts only for packages listed here. better-sqlite3 needs its install (prebuilt download, else node-gyp). wreq-js ships prebuilt @wreq-js/binding-* packages with no scripts. fsevents (macOS, via chokidar) ships a prebuilt binary, so its script is not needed."
}
