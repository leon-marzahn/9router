# 9Router environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
INITIAL_PASSWORD=change-me
DATA_DIR=/var/lib/9router

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
# Encryption key for provider credentials stored in the DB (32 bytes: 64 hex chars or base64;
# generate with `openssl rand -base64 32`). Unset: generated once into DATA_DIR/credentials.key
# (mode 0600). Back it up with the DB: without it the stored credentials can't be read.
# CREDENTIALS_KEY=
# Old keys during a rotation (comma-separated); see `vp run rotate-credentials-key`.
# CREDENTIALS_KEY_PREVIOUS=
ENABLE_REQUEST_LOGS=false
# Daily check for a newer release on GitHub (update notice + optional redeploy hook). false = off.
# REGENT_UPDATE_CHECK=true
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
# Cloud sync is OFF unless you point CLOUD_URL / NEXT_PUBLIC_CLOUD_URL at your own worker.
CLOUD_URL=
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=

# Extra Host names the dashboard and /api answer to (comma-separated; DNS-rebinding guard).
# Always allowed: localhost, 127.0.0.1, [::1], any IP address, the BASE_URL /
# NEXT_PUBLIC_BASE_URL host and the active tunnel / Tailscale hosts. Any other Host gets
# 421. Set this when you reach the dashboard by a name, e.g. behind a reverse proxy or as
# http://regent.lan:20128. /v1 requests with an API key are not affected.
# ALLOWED_HOSTS=regent.example.com,regent.lan

# Reverse proxies (besides loopback) whose X-Forwarded-For is believed, as IPs or CIDRs.
# List every hop that appends to the header, including a CDN in front of the proxy.
# Unset: only a loopback proxy is trusted and the client IP is the TCP peer.
# TRUSTED_PROXIES=172.16.0.0/12

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=9router


# Email notifications: allow an SMTP host on a private/loopback network (local relay).
# Off by default so the SMTP setting cannot be pointed at internal services.
# NOTIFY_SMTP_ALLOW_PRIVATE=true
